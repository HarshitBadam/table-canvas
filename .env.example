# =============================================================================
# Table Canvas frontend configuration (Vite)
# =============================================================================
# Copy this file to .env.local and fill in only the placeholders you need:
#   cp .env.example .env.local
#
# Variables must be prefixed with VITE_ to be exposed to the client bundle.
# IMPORTANT: Do not put passwords, JWT secrets, or database URLs in this file.
# Every VITE_* value is visible to visitors in the browser bundle.
# =============================================================================

# Required when the frontend and API use separate domains (for example Vercel
# plus an API host). For local development use http://localhost:5173/api.
# Leave unset only when nginx serves both frontend and /api on one origin.
VITE_API_URL=https://api.<your-domain>.com/api

# Keep false in production. Set true only for local development convenience.
VITE_AUTO_GUEST=false

# Optional: Sentry project DSN for browser error reporting. Safe to expose —
# a DSN only grants permission to submit events. Leave unset to disable
# reporting entirely; the SDK is then never downloaded.
# Production builds report automatically. To test it under `npm run dev`, set
# VITE_ENABLE_FRONTEND_TELEMETRY=true explicitly.
# VITE_SENTRY_DSN=https://<public-key>@<org>.ingest.<region>.sentry.io/<project-id>
# VITE_ENABLE_FRONTEND_TELEMETRY=false

# -----------------------------------------------------------------------------
# Google Sign-In (optional — button hidden when not configured)
# -----------------------------------------------------------------------------
# Must exactly match GOOGLE_CLIENT_ID on the backend.
# Get your client ID from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
